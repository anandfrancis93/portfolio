{
  "name": "anandfrancis-com",
  "version": "0.1.0",
  "private": true,
  "description": "Personal site of Anand Francis at anandfrancis.com. Static, token-driven, built under the AI-native SDLC.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-tokens.mjs --check && node scripts/build-qr.mjs --check && astro build && node scripts/postbuild.mjs",
    "build:qr": "node scripts/build-qr.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "astro check && node scripts/sync-tokens.mjs --check && node scripts/font-fallback.mjs --check && node scripts/check-content.mjs && node scripts/check-voice.mjs && node scripts/check-eol.mjs && node scripts/check-expiry.mjs && pnpm test:config",
    "lint": "prettier --check . && stylelint \"src/**/*.{css,astro}\" && node scripts/check-contrast.mjs",
    "format": "prettier --write .",
    "html": "html-validate \"dist/**/*.html\"",
    "test": "playwright test",
    "test:a11y": "playwright test --project a11y-light --project a11y-dark",
    "test:pdf": "playwright test --project pdf",
    "test:screens": "playwright test --project screens",
    "test:headers": "playwright test --project headers",
    "test:config": "node --test --test-reporter=tap \"tests/config/*.test.mjs\"",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "pnpm check && pnpm lint && pnpm build && pnpm html && pnpm test && pnpm lighthouse && pnpm audit --audit-level high",
    "deploy:preview": "node scripts/deploy.mjs --env preview",
    "deploy:production": "node scripts/deploy.mjs --env production",
    "rollback:preview": "node scripts/rollback.mjs --env preview",
    "rollback:production": "node scripts/rollback.mjs --env production",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "fonts:fallback": "node scripts/font-fallback.mjs",
    "check-expiry": "node scripts/check-expiry.mjs",
    "check-advisories": "node scripts/check-advisories.mjs",
    "eval:skills": "node scripts/eval-skills.mjs"
  },
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.6",
      "qs": ">=6.16.0",
      "uuid": ">=11.1.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-56876"
      ]
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.2.10",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.2.0",
    "@capsizecss/unpack": "4.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "html-validate": "10.17.0",
    "pdfjs-dist": "6.3.289",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "qrcode": "1.5.4",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "wrangler": "4.128.0"
  }
}
