# Dependencies and build output. No slash on node_modules, so the link the task eval puts in
# each worktree is ignored too: git does not count a link as a directory.
node_modules
dist/
.astro/

# Test and audit output, and the snapshots the Playwright MCP writes while reviewing
test-results/
playwright-report/
.lighthouseci/
.playwright-mcp/

# Cloudflare
.wrangler/
.dev.vars

# Claude Code: per-machine permission grants
.claude/settings.local.json

# Environment and secrets
.env
.env.*
!.env.example

# OS and editor noise
.DS_Store
Thumbs.db
*.log
