{
  "extraKnownMarketplaces": {
    "adlc": {
      "source": {
        "source": "github",
        "repo": "anandfrancis93/ADLC",
        "ref": "v0.7.0"
      }
    }
  },
  "enabledPlugins": {
    "adlc@adlc": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-deploy.mjs\""
          }
        ]
      }
    ]
  }
}
