---
// Projects: the designed empty state (C2 in the spec) in the panel the first project card will
// use, so the section keeps its shape when the write-up lands. Says what is empty, why, and
// the one next action.
import { profile } from "../../content/site.ts";
import Button from "../Button.astro";
import Section from "../Section.astro";

const { projects } = profile;
const { empty } = projects;
---

<Section
  id="projects"
  eyebrow={projects.eyebrow}
  heading={projects.heading}
  lede={projects.lede}
  headingWidth="projects"
>
  <div class="projects__empty">
    <p class="text-body-lg projects__empty-body measure-prose">{empty.body}</p>
    <Button
      href={empty.action.href}
      variant={empty.action.style}
      size="md"
      class="projects__empty-action"
    >
      {empty.action.label}
    </Button>
  </div>
</Section>
