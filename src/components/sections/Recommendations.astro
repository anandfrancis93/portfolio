---
// Recommendations: each one a figure holding the quote, verbatim and in curly quotes, with
// the source in the cite attribute and the attribution in the caption.
import { profile } from "../../content/site.ts";
import Section from "../Section.astro";

const { recommendations } = profile;
---

<Section
  id="recommendations"
  eyebrow={recommendations.eyebrow}
  heading={recommendations.heading}
  band="surface"
>
  <div class="recommendations__list">
    {
      recommendations.entries.map((entry) => (
        <figure class="recommendation">
          <blockquote class="text-body-xl recommendation__quote" cite={entry.source}>
            <p>“{entry.quote}”</p>
          </blockquote>
          <figcaption class="recommendation__attribution">
            <p class="text-label-md recommendation__name">{entry.name}</p>
            <p class="text-body-sm recommendation__role">{entry.title}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
