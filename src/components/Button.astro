---
// The design system's Button. Variant sets visual weight (Figma's Style property), size sets
// control height; class names mirror the Figma variants. Renders a link when href is given.
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  type?: "button" | "submit";
  class?: string;
  block?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className,
  block = false,
  ...rest
} = Astro.props;

const classes = ["btn", `btn--${variant}`, `btn--${size}`, block && "btn--block", className]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
