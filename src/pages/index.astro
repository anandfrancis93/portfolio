import "../styles/base.css";
import { profile } from "../content/site.ts";

const title = profile.identity.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
